{
  "schema_version": 1,
  "updated": "2026-07-22",
  "owner_doc": "docs/ops/CANONICAL_SOURCE_MAP.md",
  "policy_docs": [
    "plans/SUPABASE_STORAGE_POLICY.md",
    "docs/ops/DAILY_PIPELINE.md"
  ],
  "rules": {
    "canonical_rows_are_source_truth": true,
    "derived_outputs_are_rebuildable": true,
    "daily_json_sidecars_are_daily_canonical_inputs": true,
    "notebooklm_sources_are_derived_from_canonical_markdown": true,
    "rag_vectors_are_derived": true,
    "raw_audio_is_not_canonical_storage_input": true,
    "agent_found_sources_require_supabase_routing": true,
    "live_supabase_writes_need_explicit_task_approval": true
  },
  "agent_finding_persistence": {
    "applies_to": "New usable Kruse source material, transcript text, source URLs, or corrected source metadata found by an agent.",
    "classify_by": "families[].id",
    "db_destination": "families[].supabase.tables[].name with families[].supabase.tables[].conflict_target",
    "storage_destination": "families[].supabase.storage_buckets[].bucket and object_prefix when the finding includes markdown/transcript content.",
    "complete_when_live_writes_approved": "Mapped Supabase rows and Storage objects are written and row/object counts are recorded in the handoff.",
    "complete_when_live_writes_not_approved": "A dry-run/import plan or handoff records source family, table, conflict target, bucket/object path, source ID, source URL or local path, expected count, and next owner.",
    "not_complete_locations": [
      "chat history",
      ".codex-tmp",
      "issue output folders",
      "NotebookLM bundles",
      "daily report HTML",
      "local-only transcript files"
    ]
  },
  "families": [
    {
      "id": "x_daily_tweets",
      "label": "X daily tweets",
      "scope": "Raw daily @DrJackKruse X API rows, including reply, quote, retweet, media, metrics, and thread context metadata.",
      "canonical": {
        "local": {
          "status": "present",
          "primary_paths": [
            "scrapers/twitter_to_md/data/<YYYY-MM-DD>.json"
          ],
          "state_paths": [
            "scrapers/twitter_to_md/data/index.json"
          ],
          "notes": "The JSON files are the durable raw daily tweet input. Markdown is intentionally not the canonical representation for graph-shaped tweet data."
        }
      },
      "derived_outputs": [
        "summary/kruse-summary/curated/<YYYY-MM-DD>-input.json",
        "summary/kruse-summary/curated/<YYYY-MM-DD>.json",
        "summary/kruse-summary/out/<YYYY-MM-DD>.html",
        "docs/reports/<YYYY-MM-DD>.html"
      ],
      "supabase": {
        "status": "covered_by_daily_sync",
        "tables": [
          {
            "name": "tweets",
            "writer": "summary/kruse-summary/code/daily-canonical-sync.js",
            "conflict_target": "tweet_id",
            "daily": true
          }
        ],
        "storage_buckets": []
      },
      "notebooklm": {
        "status": "excluded_by_policy",
        "paths": [],
        "notes": "Daily tweet JSON is staging/input data. Long-form X thread markdown for NotebookLM is handled by the ThreadReader family."
      },
      "daily_sync": {
        "status": "automatic",
        "owner": "summary/kruse-summary/code/daily-backend-runner.js",
        "steps": [
          "Scrape X tweets",
          "Build combined daily input",
          "Sync daily canonical Supabase rows"
        ],
        "commands": [
          "scrapers/twitter_to_md: node main.js --date=$TARGET --window=24",
          "summary/kruse-summary: npm run db:daily-canonical-sync -- --date=$DATE --execute"
        ],
        "writes_supabase": true
      },
      "evidence_checks": [
        {
          "label": "daily_json_files",
          "type": "glob",
          "path": "scrapers/twitter_to_md/data/*.json"
        }
      ],
      "known_gaps": []
    },
